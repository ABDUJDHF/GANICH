--// Farm Loop
local function startFarming()
    isFarming = true
    farmStartTime = tick()
    local delay = Settings.FarmMode == "Fast" and 0.1 or 0.5
    
    Rayfield:Notify({Title = "Farm Started", Content = Settings.FarmMode .. " Mode", Duration = 3})
    
    while isFarming do
        if Settings.StopRare then
            local found, item = checkRare()
            if found then
                isFarming = false
                Rayfield:Notify({Title = "Found: " .. item, Content = "Stopping farm!", Duration = 10})
                break
            end
        end
        
        if Settings.ServerHop and (tick() - farmStartTime >= 120) then
            Rayfield:Notify({Title = "Hopping Server", Content = "Finding new server...", Duration = 3})
            hopServer()
            return
        end
        
        local chests = getChests()
        for _, c in ipairs(chests) do
            if not isFarming then break end
            if c.obj:FindFirstChild("TouchInterest") then
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(c.obj.Position + Vector3.new(0, 4, 0))
                    task.wait(delay)
                end
            end
        end
        
        task.wait(delay)
    end
end

