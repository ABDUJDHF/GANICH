--// Chest Farm Functions
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getChests()
    local chests = {}
    local hrp = getHRP()
    if not hrp then return chests end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Chest1" or obj.Name == "Chest2" or obj.Name == "Chest3") then
            if obj:FindFirstChild("TouchInterest") then
                table.insert(chests, {
                    Object = obj,
                    Distance = (obj.Position - hrp.Position).Magnitude
                })
            end
        end
    end
    
    table.sort(chests, function(a, b) return a.Distance < b.Distance end)
    return chests
end

local function checkRareItems()
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            local name = item.Name
            if name == "God's Chalice" or name:sub(1, 8) == "Fist of " then
                return true, name
            end
        end
    end
    
    if character then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name
                if name == "God's Chalice" or name:sub(1, 8) == "Fist of " then
                    return true, name
                end
            end
        end
    end
    return false, nil
end

local function hopServer()
    --// Setup auto-inject before hopping
    if queue_on_teleport then
        queue_on_teleport([[
            task.wait(2)
            pcall(function()
                loadstring(game:HttpGet("]] .. SCRIPT_URL .. [["))()
            end)
        ]])
    end
    
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        local servers = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                table.insert(servers, s.id)
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    end)
end

--// Farm Loop
local function farmLoop()
    isFarming = true
    farmStartTime = tick()
    notifiedRare = false
    local delay = Settings.FarmMode == "Fast" and 0.1 or 0.5
    
    Rayfield:Notify({
        Title = "Auto Farm Started",
        Content = "Mode: " .. Settings.FarmMode,
        Duration = 3
    })
    
    while isFarming do
        --// Check rare items
        if Settings.StopRare and not notifiedRare then
            local found, itemName = checkRareItems()
            if found then
                notifiedRare = true
                isFarming = false
                Rayfield:Notify({
                    Title = "Rare Item Found!",
                    Content = itemName .. " - Stopping farm",
                    Duration = 10
                })
                break
            end
        end
        
        --// Server hop check
        if Settings.ServerHop and (tick() - farmStartTime >= 120) then
            Rayfield:Notify({Title = "Server Hopping...", Duration = 3})
            hopServer()
            return
        end
        
        --// Collect chests
        local chests = getChests()
        for _, chestData in ipairs(chests) do
            if not isFarming then break end
            
            --// Check rare again during loop
            if Settings.StopRare then
                local found, itemName = checkRareItems()
                if found then
                    isFarming = false
                    Rayfield:Notify({
                        Title = "Found: " .. itemName,
                        Content = "Stopping!",
                        Duration = 10
                    })
                    return
                end
            end
            
            if chestData.Object:FindFirstChild("TouchInterest") then
                local hrp = getHRP()
                if hrp then
                    hrp.CFrame = CFrame.new(chestData.Object.Position + Vector3.new(0, 4, 0))
                    task.wait(delay)
                end
            end
        end
        
        task.wait(delay)
    end
end

