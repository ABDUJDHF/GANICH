local currentTargetBoat = nil
local isTweeningToBoat = false
local speedSlider = nil

local function tweenPlayerToTarget(targetCFrame, character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 8 then return end
    
    local duration = math.min(distance / 100, 3)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    isTweeningToBoat = true
    tween:Play()
    tween.Completed:Wait()
    isTweeningToBoat = false
end

local function applyBoatSpeed(speed)
    currentBoatSpeed = speed
    Settings.BoatSpeed = speed
    SaveSettings()
    
    local Boats = workspace:FindFirstChild("Boats")
    if Boats then
        for _, boat in pairs(Boats:GetChildren()) do
            local vehicleSeat = boat:FindFirstChild("VehicleSeat")
            if vehicleSeat and vehicleSeat:IsA("VehicleSeat") then
                vehicleSeat.MaxSpeed = speed
            end
        end
    end
end

local function applyNoClipToBoats(enable)
    local Boats = workspace:FindFirstChild("Boats")
    if Boats then
        for _, boat in pairs(Boats:GetChildren()) do
            for _, part in pairs(boat:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = not enable
                end
            end
            local vehicleSeat = boat:FindFirstChild("VehicleSeat")
            if vehicleSeat and vehicleSeat:IsA("VehicleSeat") then
                vehicleSeat.CanCollide = not enable
            end
        end
    end
end

local function startAutoSail()
    if autoSailEnabled then return end
    autoSailEnabled = true
    Settings.AutoSail = true
    SaveSettings()
    
    local playerName = player.Name
    local heartbeatConnection = nil
    local sitCheckInterval = 0
    local searchInterval = 0
    
    local function findMyBoat()
        local Boats = workspace:FindFirstChild("Boats")
        if not Boats then return nil end
        
        local allBoats = Boats:GetChildren()
        for _, boat in pairs(allBoats) do
            local ownerValue = boat:FindFirstChild("Owner")
            if ownerValue and ownerValue.Value == playerName then
                return boat
            end
        end
        if #allBoats == 1 then
            return allBoats[1]
        end
        return nil
    end
    
    local function tweenToMyBoat(boat)
        if isTweeningToBoat then return end
        local vehicleSeat = boat:FindFirstChild("VehicleSeat")
        if not vehicleSeat then return end
        
        local character = player.Character
        if not character then return end
        
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local distance = (hrp.Position - vehicleSeat.Position).Magnitude
        if distance > 20 and distance < 500 then
            local targetCFrame = vehicleSeat.CFrame * CFrame.new(0, 5, 0)
            task.spawn(function()
                tweenPlayerToTarget(targetCFrame, character)
            end)
        end
    end
    
    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not autoSailEnabled then
            if heartbeatConnection then heartbeatConnection:Disconnect() end
            return
        end
        
        searchInterval = searchInterval + 1
        if searchInterval >= 30 then
            searchInterval = 0
            if not currentTargetBoat or not currentTargetBoat.Parent then
                local foundBoat = findMyBoat()
                if foundBoat and foundBoat ~= currentTargetBoat then
                    currentTargetBoat = foundBoat
                    Rayfield:Notify({
                        Title = "🚢 Your Boat Found",
                        Content = "Now controlling: " .. currentTargetBoat.Name,
                        Duration = 2
                    })
                end
            end
        end
        
        sitCheckInterval = sitCheckInterval + 1
        if sitCheckInterval >= 60 then
            sitCheckInterval = 0
            if currentTargetBoat and currentTargetBoat.Parent then
                local vehicleSeat = currentTargetBoat:FindFirstChild("VehicleSeat")
                if vehicleSeat and not vehicleSeat.Occupant then
                    tweenToMyBoat(currentTargetBoat)
                end
            end
        end
        
        if currentTargetBoat and currentTargetBoat.Parent then
            local vehicleSeat = currentTargetBoat:FindFirstChild("VehicleSeat")
            if vehicleSeat and vehicleSeat:IsA("VehicleSeat") then
                if vehicleSeat.Occupant then
                    local occupantName = vehicleSeat.Occupant.Parent and vehicleSeat.Occupant.Parent.Name
                    if occupantName == playerName then
                        vehicleSeat.Throttle = 1
                        vehicleSeat.ThrottleFloat = 1
                    else
                        vehicleSeat.Throttle = 0
                        vehicleSeat.ThrottleFloat = 0
                    end
                else
                    vehicleSeat.Throttle = 0
                    vehicleSeat.ThrottleFloat = 0
                end
            end
        end
    end)
    
    autoSailThread = heartbeatConnection
    
    Rayfield:Notify({
        Title = "🚢 Auto Sail ON",
        Content = "Searching for your boat...",
        Duration = 3
    })
    
    task.spawn(function()
        task.wait(0.5)
        local foundBoat = findMyBoat()
        if foundBoat then
            currentTargetBoat = foundBoat
