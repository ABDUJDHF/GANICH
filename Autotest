--// Chest Farm Functions
local function getChests()
    local chests = {}
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return chests end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Chest1" or obj.Name == "Chest2" or obj.Name == "Chest3") then
            if obj:FindFirstChild("TouchInterest") then
                table.insert(chests, {obj = obj, dist = (obj.Position - hrp.Position).Magnitude})
            end
        end
    end
    
    table.sort(chests, function(a, b) return a.dist < b.dist end)
    return chests
end

local function checkRare()
    local bp = player:FindFirstChild("Backpack")
    local char = player.Character
    if bp then
        for _, item in pairs(bp:GetChildren()) do
            local n = item.Name
            if n == "God's Chalice" or n:sub(1, 8) == "Fist of " then return true, n end
        end
    end
    if char then
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name
                if n == "God's Chalice" or n:sub(1, 8) == "Fist of " then return true, n end
            end
        end
    end
    return false
end

local function hopServer()
    if queue_on_teleport then
        queue_on_teleport([[
            task.wait(3)
            pcall(function()
                loadstring(game:HttpGet("]] .. SCRIPT_URL .. [["))()
            end)
        ]])
    end
    
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        local servers = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                table.insert(servers, s.id)
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        end
    end)
end

--// Farm Loop
local function startFarming()
    isFarming = true
    farmStartTime = tick()
    local delay = Settings.FarmMode == "Fast" and 0.1 or 0.5
    
    Rayfield:Notify({Title = "Farm Started", Content = Settings.FarmMode .. " Mode", Duration = 3})
    
    while isFarming do
        if Settings.StopRare then
            local found, item = checkRare()
            if found then
                isFarming = false
                Rayfield:Notify({Title = "Found: " .. item, Content = "Stopping farm!", Duration = 10})
                break
            end
        end
        
        if Settings.ServerHop and (tick() - farmStartTime >= 120) then
            Rayfield:Notify({Title = "Hopping Server", Content = "Finding new server...", Duration = 3})
            hopServer()
            return
        end
        
        local chests = getChests()
        for _, c in ipairs(chests) do
            if not isFarming then break end
            if c.obj:FindFirstChild("TouchInterest") then
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = CFrame.new(c.obj.Position + Vector3.new(0, 4, 0))
                    task.wait(delay)
                end
            end
        end
        
        task.wait(delay)
    end
end

