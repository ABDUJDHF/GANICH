local function startAutoSail()
    autoSailEnabled = true
    Settings.AutoSail = true
    
    spawn(function()
        while autoSailEnabled do
            local boats = workspace:FindFirstChild("Boats")
            if boats then
                for _, boat in pairs(boats:GetChildren()) do
                    local owner = boat:FindFirstChild("Owner")
                    if owner and owner.Value == player.Name then
                        local seat = boat:FindFirstChild("VehicleSeat")
                        if seat and seat.Occupant and seat.Occupant.Parent == player.Character then
                            seat.Throttle = 1
                            seat.ThrottleFloat = 1
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
    
    Rayfield:Notify({Title = "Auto Sail", Content = "Enabled", Duration = 2})
end

local function stopAutoSail()
    autoSailEnabled = false
    Settings.AutoSail = false
    local boats = workspace:FindFirstChild("Boats")
    if boats then
        for _, boat in pairs(boats:GetChildren()) do
            local seat = boat:FindFirstChild("VehicleSeat")
            if seat then
                seat.Throttle = 0
                seat.ThrottleFloat = 0
            end
        end
    end
end

