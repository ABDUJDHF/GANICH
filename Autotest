--// Chest Farm Functions
local function getChests()
    local chests = {}
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return chests end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Chest1" or obj.Name == "Chest2" or obj.Name == "Chest3") then
            if obj:FindFirstChild("TouchInterest") then
                table.insert(chests, {obj = obj, dist = (obj.Position - hrp.Position).Magnitude})
            end
        end
    end
    
    table.sort(chests, function(a, b) return a.dist < b.dist end)
    return chests
end

local function checkRare()
    local bp = player:FindFirstChild("Backpack")
    local char = player.Character
    if bp then
        for _, item in pairs(bp:GetChildren()) do
            local n = item.Name
            if n == "God's Chalice" or n:sub(1, 8) == "Fist of " then return true, n end
        end
    end
    if char then
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Tool") then
