--// Chest Farm Loop
local function CollectionLoop()
    notifiedRareItem = false
    serverHopStartTime = tick()
    lastRespawnTime = tick()
    local delay = Settings.FarmMode == "Fast" and 0.1 or 0.5
    
    Rayfield:Notify({
        Title = "Started",
        Content = Settings.FarmMode .. " Mode",
        Duration = 3
    })
    
    while isRunning do
        if Settings.StopIfRareItems and not notifiedRareItem then
            local found, item = CheckRareItems()
            if found then
                notifiedRareItem = true
                isRunning = false
                Settings.AutoCollect = false
                SaveSettings()
                Rayfield:Notify({
                    Title = "Rare Item Found!",
                    Content = item,
                    Duration = 10
                })
                break
            end
        end
        
        if Settings.ServerHop and (tick() - serverHopStartTime >= 120) then
            Rayfield:Notify({Title = "Server Hopping", Content = "Finding new server...", Duration = 3})
            HopServer()
            return
        end
        
        local chests = GetChests()
        for _, data in ipairs(chests) do
            if not isRunning then break end
            
            if Settings.StopIfRareItems then
                local found, item = CheckRareItems()
                if found then
                    isRunning = false
                    Settings.AutoCollect = false
                    SaveSettings()
                    Rayfield:Notify({Title = "Found: " .. item, Content = "Stopping...", Duration = 10})
                    return
                end
            end
            
            if data.Object:FindFirstChild("TouchInterest") then
                TPChest(data.Object)
                task.wait(delay)
            end
        end
        
        task.wait(delay)
    end
end

