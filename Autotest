local function GetHRP()
    local char = player.Character
    if not char then player.CharacterAdded:Wait(); char = player.Character end
    return char:WaitForChild("HumanoidRootPart", 5)
end

local function CheckRareItems()
    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character
    
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            local itemName = item.Name
            if itemName == "God's Chalice" or itemName:sub(1, 8) == "Fist of " then
                return true, itemName
            end
        end
    end
    
    if character then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") then
                local itemName = item.Name
                if itemName == "God's Chalice" or itemName:sub(1, 8) == "Fist of " then
                    return true, itemName
                end
            end
        end
    end
    return false, nil
end

local function DoRespawn()
    isRespawning = true
    task.wait(0.5)
    
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        else
            char:Destroy()
        end
    end
    
    player.CharacterAdded:Wait()
    task.wait(0.5)
    isRespawning = false
    lastRespawnTime = tick()
end

local function GetChests()
    local chests = {}
    local hrp = GetHRP()
    local pos = hrp and hrp.Position or Vector3.new(0, 0, 0)
    
    for _, service in pairs(game:GetChildren()) do
        pcall(function()
            for _, obj in pairs(service:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name == "Chest1" or obj.Name == "Chest2" or obj.Name == "Chest3") then
                    if obj:FindFirstChild("TouchInterest") then
                        table.insert(chests, {Object = obj, Distance = (obj.Position - pos).Magnitude})
                    end
                end
            end
        end)
    end
    
    table.sort(chests, function(a, b) return a.Distance < b.Distance end)
    return chests
end

local function TPChest(chest)
    local hrp = GetHRP()
    if not hrp or not chest or not chest.Parent then return false end
    hrp.CFrame = CFrame.new(chest.Position + Vector3.new(0, 4, 0))
    return true
end

--// تعديل: Server Hop مع Auto-Inject
local function HopServer()
    --// نفعل الـ auto-inject قبل الانتقال
    setupAutoInject()
    
    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))
        local servers = {}
        for _, s in ipairs(data.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then 
                table.insert(servers, s.id) 
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    end)
end

task.spawn(function()
    while true do
        if isRunning and not isRespawning and (tick() - lastRespawnTime >= 8.5) then
            DoRespawn()
        end
        task.wait(0.5)
    end
end)

local function CollectionLoop()
    notifiedRareItem = false
    serverHopStartTime = tick()
    lastRespawnTime = tick()
    
    local tpDelay = Settings.FarmMode == "Fast" and 0.1 or 0.5
    
    Rayfield:Notify({
        Title = "✨ Collecting Chests", 
        Content = "Auto farm started (" .. Settings.FarmMode .. " Mode)...", 
        Duration = 4
    })
    
    while isRunning do
        if Settings.StopIfRareItems and not notifiedRareItem then
            local hasRare, itemName = CheckRareItems()
            if hasRare then
                notifiedRareItem = true
                isRunning = false
                Settings.AutoCollect = false
                Settings.ServerHop = false
                SaveSettings()
                if AutoToggleRef then AutoToggleRef:Set(false) end
                if ServerHopToggleRef then ServerHopToggleRef:Set(false) end
                Rayfield:Notify({Title = "🎉 Found!", Content = itemName .. "! Stopping.", Duration = 10})
                break
            end
        end
        
        if Settings.ServerHop and (tick() - serverHopStartTime >= 120) then
            Rayfield:Notify({Title = "🌐 Hopping...", Content = "New server", Duration = 3})
            SaveSettings()
            HopServer()
            return
        end
        
        if isRespawning then
            task.wait(0.1)
            continue
        end
        
        local chests = GetChests()
        for _, data in ipairs(chests) do
            if isRespawning then break end
            if not isRunning then break end
            
            if Settings.StopIfRareItems then
                local hasRare, itemName = CheckRareItems()
                if hasRare then
                    isRunning = false
                    Settings.AutoCollect = false
                    Settings.ServerHop = false
                    SaveSettings()
                    if AutoToggleRef then AutoToggleRef:Set(false) end
                    if ServerHopToggleRef then ServerHopToggleRef:Set(false) end
                    Rayfield:Notify({Title = "🎉 Found!", Content = itemName .. "!", Duration = 10})
                    return
                end
            end
            
            if not data.Object:FindFirstChild("TouchInterest") then continue end
            if TPChest(data.Object) then 
                task.wait(tpDelay)
            end
        end
        
        task.wait(tpDelay)
    end
end

